<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/track_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/track_item_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/track_item_map"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/track_show_map"
        android:scaleType="centerInside"
        android:src="@drawable/ic_map"
        android:tint="@color/colorAccent" />

    <ImageButton
        android:id="@+id/track_item_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/track_play"
        android:scaleType="centerInside"
        android:src="@drawable/ic_play"
        android:tint="@color/colorAccent" />

    <ImageButton
        android:id="@+id/track_item_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/track_delete"
        android:scaleType="centerInside"
        android:src="@drawable/ic_delete"
        android:tint="#FFB00020" />
</LinearLayout>