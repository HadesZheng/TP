<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="500dp"
    android:minWidth="300dp"
    android:background="@drawable/border_window">

    <TextView
        android:id="@+id/joystick_track_tips"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_horizontal|center_vertical"
        android:text="@string/track_title"
        android:textSize="18sp" />

    <ImageButton
        android:id="@+id/joystick_track_close"
        android:layout_width="@dimen/joystick_btn_width"
        android:layout_height="@dimen/joystick_btn_height"
        android:layout_gravity="top|end"
        android:layout_marginEnd="3dp"
        android:layout_marginTop="5dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:src="@drawable/ic_close"
        android:theme="@style/RippleWhite" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="42dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/track_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/track_status_idle"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/track_record_btn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/track_record_start"
                android:textSize="13sp" />

            <Button
                android:id="@+id/track_stop_btn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/track_play_stop"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/track_pause_btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/track_pause"
                android:textSize="12sp" />

            <Button
                android:id="@+id/track_loop_btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/track_loop_off"
                android:textSize="12sp" />

            <Button
                android:id="@+id/track_speed_btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/track_speed_1x"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/track_export_btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/track_export"
                android:textSize="12sp" />

            <Button
                android:id="@+id/track_import_btn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/track_import"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/track_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:text="@string/track_hint"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/track_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/track_empty"
                android:textSize="13sp" />

            <ListView
                android:id="@+id/track_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#33CCCCCC"
                android:dividerHeight="1dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>